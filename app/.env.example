# Copy this file to .env and fill in the values from the Supabase dashboard:
#   Project Settings → API
#
# .env is git-ignored. .env.example is not — never put a real value in this file.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The publishable / anon key.
#
# This one is MEANT to reach the browser: Vite inlines every VITE_* variable into
# the built bundle, so anyone can read it from the shipped JavaScript. That is
# safe here only because row level security is enabled on all 27 tables and the
# anon role can read nothing — which `npm run check:supabase` verifies.
VITE_SUPABASE_ANON_KEY=

# The service_role key must NEVER be defined with a VITE_ prefix, or in this app
# at all: it bypasses row level security completely. Keep it server side only —
# an edge function, a migration job, or your own shell.
# SUPABASE_SERVICE_ROLE_KEY=   <- do not add this here
